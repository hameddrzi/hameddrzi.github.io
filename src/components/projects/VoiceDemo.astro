---
// Voice micro-demo: 3D-tilted phone cycling the real screenshots + a self-typing, trilingual live transcript.
// OWNER: Agent "projects".
import type { Lang, Project } from '../../data/cv';
interface Props { project: Project; lang: Lang }
const { project, lang } = Astro.props;

const L = {
  live: { en: 'Live transcript', it: 'Trascrizione live' },
  note: { en: 'Illustrative demo · runs on-device', it: 'Demo illustrativa · on-device' },
  shots: { en: 'Screenshots of the Voice app', it: "Schermate dell'app Voice" },
};
const alts = [
  {
    en: 'Voice app: a finished recording with its time-coded English transcript and a playback waveform',
    it: "App Voice: una registrazione conclusa con la trascrizione inglese con timestamp e la forma d'onda",
  },
  {
    en: 'Voice app while recording: timer at 4 seconds, red live waveform and the live transcript panel listening',
    it: "App Voice in registrazione: timer a 4 secondi, forma d'onda rossa e pannello di trascrizione live in ascolto",
  },
  {
    en: 'Voice app record screen, ready to record, with a Persian / English language switch',
    it: 'Schermata di registrazione di Voice, pronta, con il selettore di lingua persiano / inglese',
  },
];
// Illustrative sample lines (not real recordings).
const samples = [
  { code: 'IT', lang: 'it', dir: 'ltr', lines: ['Ciao, questa è una nota vocale.', 'Domani alle dieci ho una riunione.'] },
  { code: 'EN', lang: 'en', dir: 'ltr', lines: ['Hi, this is a quick voice note.', 'Remind me to call the team at ten.'] },
  { code: 'FA', lang: 'fa', dir: 'rtl', lines: ['سلام، این یک یادداشت صوتی است.', 'فردا ساعت ده جلسه دارم.'] },
];
const stamps = ['0:00', '0:04'];
const images = project.images ?? [];
const bars = Array.from({ length: 28 }, (_, k) => k);
---
<div class="vd" data-demo="voice" data-samples={JSON.stringify(samples)}>
  <div class="vd-stage">
    <div class="vd-phone" data-vd-phone>
      <div class="vd-screen" role="group" aria-label={L.shots[lang]}>
        {images.map((src, k) => (
          <img
            class:list={['vd-shot', k === 0 && 'is-on']}
            src={src}
            width="576"
            height="1280"
            loading="lazy"
            decoding="async"
            alt={alts[k]?.[lang] ?? ''}
          />
        ))}
      </div>
      <span class="vd-glare" aria-hidden="true"></span>
    </div>
  </div>

  <div class="vd-card">
    <div class="vd-head">
      <span class="vd-rec" aria-hidden="true"></span>
      <span class="meta vd-title">{L.live[lang]}</span>
      <span class="meta vd-lang" data-vd-lang>{samples[0].code}</span>
    </div>
    <svg class="vd-wave" viewBox="0 0 112 24" preserveAspectRatio="none" aria-hidden="true">
      {bars.map((k) => <rect class="vd-bar" x={k * 4} y="2" width="2" height="20" rx="1" style={`--k:${k}`} />)}
    </svg>
    <ol class="vd-lines" data-vd-lines>
      {stamps.map((s, k) => (
        <li class="vd-line">
          <span class="vd-ts">{s}</span>
          <span class="vd-tx" lang={samples[0].lang} dir={samples[0].dir}>{samples[0].lines[k]}</span>
        </li>
      ))}
    </ol>
    <p class="meta vd-note">{L.note[lang]}</p>
  </div>
</div>

<style>
  .vd {
    --phone-h: min(62svh, 560px);
    position: relative;
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .vd-stage {
    perspective: 1200px;
    padding: 12px;
  }
  .vd-phone {
    position: relative;
    width: min(60vw, 240px);
    aspect-ratio: 576 / 1280;
    padding: 9px;
    border-radius: 38px;
    background: linear-gradient(150deg, #23232c, #0b0b10 60%);
    border: 1px solid var(--line-strong);
    box-shadow:
      0 0 0 1px rgb(0 0 0 / 0.6) inset,
      0 40px 80px -30px rgb(0 0 0 / 0.9),
      0 0 80px -20px color-mix(in srgb, var(--accent) 40%, transparent);
    transform: rotateX(6deg) rotateY(-14deg);
    transform-style: preserve-3d;
    will-change: transform;
  }
  .vd-screen {
    position: relative;
    width: 100%;
    height: 100%;
    border-radius: 30px;
    overflow: hidden;
    background: #f4f6fb;
  }
  .vd-shot {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transform: scale(1.04);
    transition: opacity 0.9s var(--ease-out), transform 1.6s var(--ease-out);
  }
  .vd-shot.is-on { opacity: 1; transform: none; }
  .vd-glare {
    position: absolute;
    inset: 9px;
    border-radius: 30px;
    pointer-events: none;
    background: linear-gradient(115deg, rgb(255 255 255 / 0.18), transparent 35%, transparent 70%, rgb(255 255 255 / 0.05));
    mix-blend-mode: screen;
  }

  .vd-card {
    position: relative;
    z-index: 2;
    width: min(100%, 340px);
    margin-top: -88px;
    padding: 16px 16px 14px;
    background: rgb(11 11 16 / 0.94);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    box-shadow: 0 30px 60px -30px rgb(0 0 0 / 0.9);
  }
  .vd-card::before {
    content: '';
    position: absolute;
    top: -1px;
    left: 20px;
    right: 20px;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--accent), transparent);
  }
  .vd-head {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .vd-rec {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #ff4d4d;
    box-shadow: 0 0 0 0 rgb(255 77 77 / 0.6);
    animation: vd-rec 1.6s ease-out infinite;
  }
  .vd-title { color: var(--fg-2); }
  .vd-lang {
    margin-left: auto;
    padding: 3px 8px;
    border-radius: 999px;
    border: 1px solid color-mix(in srgb, var(--accent) 55%, transparent);
    color: var(--accent);
    min-width: 3.2em;
    text-align: center;
  }
  .vd-wave {
    width: 100%;
    height: 24px;
    margin-top: 12px;
    display: block;
  }
  .vd-bar {
    fill: var(--accent);
    transform-box: fill-box;
    transform-origin: center;
    transform: scaleY(0.3);
    animation: vd-bar 1.1s ease-in-out infinite alternate;
    animation-delay: calc(var(--k) * -0.13s);
    opacity: 0.85;
  }
  .vd-bar:nth-child(3n) { animation-duration: 0.8s; }
  .vd-bar:nth-child(4n + 1) { animation-duration: 1.4s; }
  .vd.is-paused .vd-bar,
  .vd.is-paused .vd-rec { animation-play-state: paused; }

  .vd-lines {
    margin-top: 12px;
    display: grid;
    gap: 10px;
    min-height: 6.2em;
  }
  .vd-line {
    display: grid;
    grid-template-columns: 3.2em 1fr;
    gap: 10px;
    align-items: baseline;
    font-size: 0.95rem;
    line-height: 1.4;
  }
  .vd-ts {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--accent);
  }
  .vd-tx { color: var(--fg); min-height: 1.4em; }
  .vd-tx[dir='rtl'] { text-align: right; font-family: system-ui, 'Vazirmatn', 'Noto Sans Arabic', sans-serif; }
  .vd-tx.is-typing::after {
    content: '';
    display: inline-block;
    width: 2px;
    height: 1em;
    margin-inline-start: 2px;
    vertical-align: -0.12em;
    background: var(--accent);
    animation: vd-caret 0.8s steps(1) infinite;
  }
  .vd-note {
    margin-top: 12px;
    font-size: 0.66rem;
    color: var(--fg-3);
  }

  @keyframes vd-bar { to { transform: scaleY(1); } }
  @keyframes vd-rec { 70%, 100% { box-shadow: 0 0 0 8px rgb(255 77 77 / 0); } }
  @keyframes vd-caret { 50% { opacity: 0; } }

  @media (min-width: 1024px) {
    .vd {
      flex-direction: row;
      justify-content: center;
      align-items: center;
      min-height: calc(var(--phone-h) + 24px);
    }
    .vd-phone {
      width: auto;
      height: var(--phone-h);
      border-radius: 44px;
      padding: 10px;
    }
    .vd-screen, .vd-glare { border-radius: 35px; }
    .vd-glare { inset: 10px; }
    .vd-card {
      position: absolute;
      left: 0;
      bottom: 6%;
      margin: 0;
      width: clamp(250px, 54%, 330px);
      transform: translateZ(0);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .vd-bar { animation: none; transform: scaleY(0.6); }
    .vd-rec { animation: none; }
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { reducedMotion, finePointer, visibilityGate, whenReady } from './runtime';

  type Sample = { code: string; lang: string; dir: string; lines: string[] };

  function initVoice(root: HTMLElement) {
    const samples: Sample[] = JSON.parse(root.dataset.samples || '[]');
    const shots = Array.from(root.querySelectorAll<HTMLImageElement>('.vd-shot'));
    const phone = root.querySelector<HTMLElement>('[data-vd-phone]');
    const langEl = root.querySelector<HTMLElement>('[data-vd-lang]');
    const txs = Array.from(root.querySelectorAll<HTMLElement>('.vd-tx'));
    const reduce = reducedMotion();

    if (reduce) {
      root.classList.add('is-paused');
      return; // static: first screenshot + Italian lines, final state
    }

    // ---- 3D tilt following the mouse (over the whole panel) ----
    const panel = root.closest<HTMLElement>('.pj-panel');
    if (phone && panel && finePointer()) {
      const rx = gsap.quickTo(phone, 'rotationX', { duration: 0.9, ease: 'power3.out' });
      const ry = gsap.quickTo(phone, 'rotationY', { duration: 0.9, ease: 'power3.out' });
      gsap.set(phone, { rotationX: 6, rotationY: -14, transformPerspective: 0 });
      panel.addEventListener('pointermove', (e) => {
        const r = phone.getBoundingClientRect();
        const nx = (e.clientX - (r.left + r.width / 2)) / (window.innerWidth / 2);
        const ny = (e.clientY - (r.top + r.height / 2)) / (window.innerHeight / 2);
        ry(gsap.utils.clamp(-24, 24, -8 + nx * 22));
        rx(gsap.utils.clamp(-16, 16, 4 - ny * 14));
      });
      panel.addEventListener('pointerleave', () => {
        rx(6);
        ry(-14);
      });
    }

    // ---- screenshot crossfade + transcript typing, paused offscreen / hidden tab ----
    let shotIdx = 0;
    let shotTimer = 0;
    let typeTimer = 0;
    let langIdx = 0;

    const nextShot = () => {
      shots[shotIdx]?.classList.remove('is-on');
      shotIdx = (shotIdx + 1) % shots.length;
      shots[shotIdx]?.classList.add('is-on');
    };

    const setLang = (s: Sample) => {
      if (langEl) langEl.textContent = s.code;
      txs.forEach((t) => {
        t.setAttribute('lang', s.lang);
        t.setAttribute('dir', s.dir);
        t.textContent = '';
        t.classList.remove('is-typing');
      });
    };

    // simple step machine: type line 0, pause, type line 1, hold, next language
    const runLanguage = () => {
      const s = samples[langIdx];
      setLang(s);
      let line = 0;
      let ch = 0;
      const step = () => {
        const el = txs[line];
        const text = s.lines[line] ?? '';
        if (!el) return;
        el.classList.add('is-typing');
        // type grapheme-ish chunks (keeps Persian joins sane)
        const chars = [...text];
        ch++;
        el.textContent = chars.slice(0, ch).join('');
        if (ch < chars.length) {
          typeTimer = window.setTimeout(step, 28 + Math.random() * 46);
        } else if (line < txs.length - 1) {
          el.classList.remove('is-typing');
          line++;
          ch = 0;
          typeTimer = window.setTimeout(step, 650);
        } else {
          typeTimer = window.setTimeout(() => {
            el.classList.remove('is-typing');
            langIdx = (langIdx + 1) % samples.length;
            runLanguage();
          }, 2400);
        }
      };
      typeTimer = window.setTimeout(step, 380);
    };

    const start = () => {
      root.classList.remove('is-paused');
      window.clearInterval(shotTimer);
      shotTimer = window.setInterval(nextShot, 3200);
      window.clearTimeout(typeTimer);
      runLanguage();
    };
    const stop = () => {
      root.classList.add('is-paused');
      window.clearInterval(shotTimer);
      window.clearTimeout(typeTimer);
      txs.forEach((t) => t.classList.remove('is-typing'));
    };

    whenReady(() => {
      visibilityGate(root, (on) => (on ? start() : stop()));
    });
  }

  document.querySelectorAll<HTMLElement>('[data-demo="voice"]').forEach(initVoice);
</script>
