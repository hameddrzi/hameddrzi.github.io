---
// OWNER: Agent "shell". Markup + styles; logic in src/scripts/fx/cursor.ts.
// Native cursor is hidden only once this one is live (html.has-cursor), desktop fine pointers only.
import type { Lang } from '../data/cv';
interface Props { lang: Lang }
const { lang: _lang } = Astro.props;
---
<div class="cursor" data-cursor-root aria-hidden="true">
  <div class="cursor__ring" data-cursor-ring><span class="cursor__ring-in"></span></div>
  <div class="cursor__pill" data-cursor-pill><span class="cursor__pill-in"><span data-cursor-label></span></span></div>
  <div class="cursor__dot" data-cursor-dot><span class="cursor__dot-in"></span></div>
</div>

<style>
  .cursor { position: fixed; inset: 0; z-index: var(--z-cursor); pointer-events: none; opacity: 0; transition: opacity 0.35s var(--ease-out); }
  .cursor:global(.is-visible) { opacity: 1; }
  @media not all and (hover: hover) and (pointer: fine) { .cursor { display: none; } }

  .cursor__ring, .cursor__dot, .cursor__pill { position: fixed; left: 0; top: 0; width: 0; height: 0; will-change: transform; }

  .cursor__ring { mix-blend-mode: difference; }
  .cursor__ring-in {
    position: absolute; left: -20px; top: -20px; width: 40px; height: 40px; border-radius: 50%;
    border: 1px solid #fff; background: transparent;
    transition: transform 0.55s var(--ease-out), background-color 0.4s var(--ease-out), border-color 0.4s;
  }
  .cursor__dot-in {
    position: absolute; left: -3px; top: -3px; width: 6px; height: 6px; border-radius: 50%;
    background: var(--signal);
    transition: transform 0.4s var(--ease-out);
  }
  .cursor__pill-in {
    position: absolute; left: 0; top: 0; transform: translate(-50%, -50%) scale(0);
    display: inline-flex; align-items: center; justify-content: center;
    min-width: 88px; height: 88px; padding: 0 22px; border-radius: 999px;
    background: var(--signal); color: var(--signal-ink);
    font-family: var(--font-mono); font-size: 0.72rem; letter-spacing: 0.1em; text-transform: uppercase; white-space: nowrap;
    transition: transform 0.5s var(--ease-out);
  }

  /* hover on links/buttons: ring grows into a solid inverted disc, dot hides */
  .cursor:global(.is-hover) .cursor__ring-in { transform: scale(1.75); background: #fff; }
  .cursor:global(.is-hover) .cursor__dot-in { transform: scale(0); }
  /* labelled: pill takes over */
  .cursor:global(.is-label) .cursor__ring-in { transform: scale(0); }
  .cursor:global(.is-label) .cursor__dot-in { transform: scale(0); }
  .cursor:global(.is-label) .cursor__pill-in { transform: translate(-50%, -50%) scale(1); }
  .cursor:global(.is-down) .cursor__ring-in { transform: scale(0.7); }
  .cursor:global(.is-down.is-hover) .cursor__ring-in { transform: scale(1.45); }
</style>
