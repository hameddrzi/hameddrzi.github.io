---
// OWNER: Agent "shell". Contact + footer. GL forms a vortex behind.
import { profile, ui, tr, type Lang } from '../data/cv';
interface Props { lang: Lang }
const { lang } = Astro.props;
const hello = tr(ui.sayHello, lang).split(' ');
const helloLast = hello.pop();
const emailChars = Array.from(profile.email);
const it = lang === 'it';
const rows = [
  { k: 'LinkedIn', v: 'in/hamed-darzi', href: profile.linkedin, ext: true, cur: 'Open' },
  { k: 'GitHub', v: 'github.com/hameddrzi', href: profile.github, ext: true, cur: 'Open' },
  { k: 'CV — EN', v: 'Hamed_Darzi_CV_EN.pdf', href: profile.cvPdf.en, ext: false, dl: true, cur: 'PDF' },
  { k: 'CV — IT', v: 'Hamed_Darzi_CV_IT.pdf', href: profile.cvPdf.it, ext: false, dl: true, cur: 'PDF' },
];
const t = {
  back: it ? 'Torna su' : 'Back to top',
  turin: it ? 'Torino' : 'Turin',
  write: it ? 'Scrivi' : 'Write',
  lang: it ? 'Lingua' : 'Language',
};
---
<section id="contact" class="contact" data-gl="contact" data-gl-side="center" aria-labelledby="contact-title">
  <div class="wrap contact__inner">
    <p class="meta contact__meta" data-reveal="fade"><span class="contact__num">(05)</span> — {tr(ui.nav.contact, lang)}</p>

    <h2 id="contact-title" class="contact__title" data-split="chars">
      {hello.join(' ')} <span class="serif">{helloLast}</span>
    </h2>

    <div class="contact__mail">
      <div data-reveal="up">
        <a class="contact__email" href={`mailto:${profile.email}`} data-magnetic="0.12" data-cursor={t.write} aria-label={`Email ${profile.email}`}>
          <span class="contact__roll" aria-hidden="true">
            {emailChars.map((c, i) => (
              <span class="contact__rc" style={`--i:${i}`}><span>{c}</span><span>{c}</span></span>
            ))}
          </span>
          <span class="contact__underline" aria-hidden="true"></span>
        </a>
      </div>
      <div class="contact__copywrap" data-reveal="up" data-delay="0.1">
        <button type="button" class="btn contact__copy" data-copy-email={profile.email} data-copied={tr(ui.copied, lang)} data-magnetic>
          <span class="contact__copy-ico" aria-hidden="true"></span>
          <span data-copy-label>{tr(ui.copyEmail, lang)}</span>
        </button>
        <span class="sr-only" aria-live="polite" data-copy-live></span>
      </div>
    </div>

    <ul class="contact__rows">
      {rows.map((r) => (
        <li data-reveal="up">
          <a class="contact__row" href={r.href} target={r.ext ? '_blank' : undefined} rel={r.ext ? 'noopener' : undefined} download={r.dl ? '' : undefined} data-cursor={r.cur}>
            <span class="meta contact__row-k">{r.k}</span>
            <span class="contact__row-v">{r.v}</span>
            <span class="contact__row-arrow" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="24" height="24"><path d="M6 18L18 6M8 6h10v10" fill="none" stroke="currentColor" stroke-width="1.5" /></svg>
            </span>
          </a>
        </li>
      ))}
    </ul>
  </div>

  <footer class="footer">
    <div class="wrap footer__bar meta">
      <p class="footer__copy">© 2026 — {tr(ui.rights, lang)}</p>
      <p class="footer__time"><span class="footer__dot" aria-hidden="true"></span>{t.turin} <time data-clock="hms">--:--:--</time></p>
      <nav class="footer__lang" aria-label={t.lang}>
        <a href="/" hreflang="en" lang="en" aria-current={lang === 'en' ? 'true' : undefined}>EN</a>
        <span aria-hidden="true">/</span>
        <a href="/it/" hreflang="it" lang="it" aria-current={lang === 'it' ? 'true' : undefined}>IT</a>
      </nav>
      <a class="footer__top" href="#top" data-magnetic="0.25">
        <span>{t.back}</span><span class="footer__top-arrow" aria-hidden="true">↑</span>
      </a>
    </div>
    <div class="footer__mark" aria-hidden="true"><span data-footer-mark>{profile.lastName.toUpperCase()}</span></div>
  </footer>
</section>

<style>
  .contact { padding-top: var(--section-y); overflow: hidden; overflow: clip; }
  .contact__inner { position: relative; display: grid; gap: clamp(28px, 4vw, 56px); }
  .contact__inner::before {
    content: ''; position: absolute; left: 50%; top: 22%; width: 120%; height: 70%; translate: -50% -30%; z-index: -1; pointer-events: none;
    background: radial-gradient(closest-side, rgba(5, 5, 7, 0.7), rgba(5, 5, 7, 0.35) 60%, rgba(5, 5, 7, 0));
  }
  .contact__num { color: var(--signal); }
  .contact__title {
    font-size: clamp(3.1rem, 13.6vw, 14rem); font-weight: 650; letter-spacing: -0.055em; line-height: 0.86;
    max-width: 10em;
  }
  .contact__title .serif { color: var(--signal); font-size: 1.04em; letter-spacing: -0.02em; }

  .contact__mail { display: grid; gap: 22px; justify-items: start; }
  .contact__email {
    position: relative; display: inline-block; max-width: 100%;
    font-size: clamp(1.45rem, 6.1vw, 7.2rem); font-weight: 500; letter-spacing: -0.045em; line-height: 1.05;
    padding-bottom: 0.08em;
  }
  .contact__roll { display: inline-flex; white-space: nowrap; }
  .contact__rc { position: relative; display: inline-block; overflow: hidden; height: 1.12em; line-height: 1.12em; }
  .contact__rc > span { display: block; transition: transform 0.7s var(--ease-out); transition-delay: calc(var(--i) * 14ms); }
  .contact__rc > span + span { position: absolute; left: 0; top: 100%; color: var(--signal); font-family: var(--font-serif); font-style: italic; font-weight: 400; }
  .contact__email:hover .contact__rc > span, .contact__email:focus-visible .contact__rc > span { transform: translateY(-100%); }
  .contact__underline { position: absolute; left: 0; right: 0; bottom: 0; height: 2px; background: var(--line-strong); overflow: hidden; }
  .contact__underline::after { content: ''; position: absolute; inset: 0; background: var(--signal); transform: scaleX(0); transform-origin: 100% 50%; transition: transform 0.9s var(--ease-out); }
  .contact__email:hover .contact__underline::after, .contact__email:focus-visible .contact__underline::after { transform: scaleX(1); transform-origin: 0 50%; }

  .contact__copywrap { display: flex; align-items: center; gap: 14px; }
  .contact__copy-ico { position: relative; width: 12px; height: 12px; border: 1px solid currentColor; border-radius: 2px; }
  .contact__copy-ico::after { content: ''; position: absolute; left: 3px; top: -5px; width: 12px; height: 12px; border: 1px solid currentColor; border-radius: 2px; opacity: 0.6; }
  .contact__copy:global(.is-copied) { color: var(--signal-ink); border-color: var(--signal); }
  .contact__copy:global(.is-copied)::before { transform: none; }

  .contact__rows { border-top: 1px solid var(--line); margin-top: clamp(8px, 2vw, 32px); }
  .contact__row {
    position: relative; display: grid; grid-template-columns: 1fr auto; grid-template-areas: 'k a' 'v a';
    align-items: center; gap: 4px 16px; padding: 18px 0; border-bottom: 1px solid var(--line); overflow: hidden;
  }
  .contact__row::before {
    content: ''; position: absolute; left: 0; bottom: -1px; height: 1px; width: 100%; background: var(--signal);
    transform: scaleX(0); transform-origin: 0 50%; transition: transform 0.8s var(--ease-out);
  }
  .contact__row-k { grid-area: k; color: var(--fg-3); transition: color 0.4s; }
  .contact__row-v { grid-area: v; font-size: clamp(1.15rem, 2.3vw, 2.1rem); letter-spacing: -0.03em; line-height: 1.15; transition: transform 0.7s var(--ease-out); overflow-wrap: anywhere; }
  .contact__row-arrow {
    grid-area: a; display: grid; place-items: center; width: 44px; height: 44px; border-radius: 50%; border: 1px solid var(--line-strong);
    transition: transform 0.7s var(--ease-out), background-color 0.4s, color 0.4s, border-color 0.4s;
    transform: rotate(-45deg);
  }
  .contact__row-arrow svg { width: 18px; height: 18px; transform: rotate(45deg); }
  .contact__row:hover::before, .contact__row:focus-visible::before { transform: scaleX(1); }
  .contact__row:hover .contact__row-v, .contact__row:focus-visible .contact__row-v { transform: translateX(14px); }
  .contact__row:hover .contact__row-k, .contact__row:focus-visible .contact__row-k { color: var(--signal); }
  .contact__row:hover .contact__row-arrow, .contact__row:focus-visible .contact__row-arrow { transform: rotate(0deg) translateX(-6px); background: var(--signal); color: var(--signal-ink); border-color: var(--signal); }
  .contact__row[download] .contact__row-arrow svg { transform: rotate(135deg); }
  @media (min-width: 768px) {
    .contact__row { grid-template-columns: minmax(140px, 0.6fr) 2fr auto; grid-template-areas: 'k v a'; padding: 26px 0; }
  }

  /* ---------- footer ---------- */
  .footer { position: relative; margin-top: clamp(80px, 14vw, 180px); }
  .footer__bar {
    display: grid; grid-template-columns: 1fr auto; gap: 14px 20px; align-items: center;
    padding-block: 22px; border-top: 1px solid var(--line); color: var(--fg-3);
  }
  .footer__copy { grid-column: 1 / -1; }
  .footer__time { display: inline-flex; align-items: center; gap: 8px; }
  .footer__time time { color: var(--fg); font-variant-numeric: tabular-nums; }
  .footer__dot { width: 6px; height: 6px; border-radius: 50%; background: var(--signal); }
  .footer__lang { display: inline-flex; gap: 6px; justify-self: end; }
  .footer__lang a { display: inline-grid; place-items: center; min-width: 44px; min-height: 44px; transition: color 0.3s; }
  .footer__lang a:hover { color: var(--fg); }
  .footer__lang a[aria-current='true'] { color: var(--signal); }
  .footer__top { grid-column: 1 / -1; justify-self: start; display: inline-flex; align-items: center; gap: 10px; color: var(--fg); min-height: 44px; }
  .footer__top-arrow { display: inline-grid; place-items: center; width: 40px; height: 40px; border-radius: 50%; border: 1px solid var(--line-strong); transition: transform 0.6s var(--ease-out), background-color 0.4s, color 0.4s; }
  .footer__top:hover .footer__top-arrow { transform: translateY(-4px); background: var(--signal); color: var(--signal-ink); border-color: var(--signal); }
  @media (min-width: 900px) {
    .footer__bar { grid-template-columns: 1fr auto auto auto; }
    .footer__copy, .footer__top { grid-column: auto; }
    .footer__top { justify-self: end; }
  }
  .footer__mark {
    position: relative; overflow: hidden; height: 0.56em; line-height: 0.8;
    font-size: 32.5vw; font-weight: 800; letter-spacing: -0.065em; text-align: center; user-select: none; pointer-events: none;
  }
  .footer__mark span {
    display: inline-block; margin-left: -0.06em;
    background: linear-gradient(to bottom, var(--fg) 0%, rgba(242, 240, 234, 0.25) 45%, rgba(242, 240, 234, 0) 78%);
    -webkit-background-clip: text; background-clip: text; color: transparent;
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  const btn = document.querySelector<HTMLButtonElement>('[data-copy-email]');
  if (btn) {
    const label = btn.querySelector<HTMLElement>('[data-copy-label]');
    const live = document.querySelector<HTMLElement>('[data-copy-live]');
    const original = label?.textContent || 'Copy email';
    const done = btn.dataset.copied || 'Copied';
    const email = btn.dataset.copyEmail || '';
    let timer: number | undefined;
    const fallback = () => {
      const ta = document.createElement('textarea');
      ta.value = email; ta.setAttribute('readonly', ''); ta.style.position = 'fixed'; ta.style.opacity = '0';
      document.body.appendChild(ta); ta.select();
      try { document.execCommand('copy'); } catch { /* noop */ }
      ta.remove();
    };
    btn.addEventListener('click', async () => {
      try { await navigator.clipboard.writeText(email); } catch { fallback(); }
      if (label) label.textContent = done;
      if (live) live.textContent = `${done}: ${email}`;
      btn.classList.add('is-copied');
      window.dispatchEvent(new CustomEvent('gl:pulse', { detail: { strength: 1 } }));
      window.clearTimeout(timer);
      timer = window.setTimeout(() => {
        if (label) label.textContent = original;
        if (live) live.textContent = '';
        btn.classList.remove('is-copied');
      }, 2200);
    });
  }

  const mark = document.querySelector<HTMLElement>('[data-footer-mark]');
  if (mark && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    gsap.fromTo(mark, { yPercent: 55 }, {
      yPercent: 0, ease: 'none',
      scrollTrigger: { trigger: mark.parentElement, start: 'top bottom', end: 'bottom bottom', scrub: true },
    });
  }
</script>
