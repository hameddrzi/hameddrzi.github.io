---
// OWNER: Agent "shell". Hero: massive editorial name, film-HUD details, GL "signal core" behind.
import { profile, ui, tr, type Lang } from '../data/cv';
interface Props { lang: Lang }
const { lang } = Astro.props;
const first = profile.firstName.toUpperCase();
const last = profile.lastName.toUpperCase();
const [focusA, ...focusRest] = tr(profile.focus, lang).split(' & ');
const coords = '45.0703° N, 7.6869° E';
---
<section id="top" class="hero" data-gl="hero" data-gl-side="center" aria-labelledby="hero-title">
  <h1 id="hero-title" class="sr-only">{profile.name} — {tr(profile.role, lang)}, {tr(profile.focus, lang)}</h1>

  <div class="hero__grid wrap">
    <div class="hero__word hero__word--a" data-hero-word="a" aria-hidden="true">
      <span class="hero__tilt" data-hero-tilt="1.0">
        {Array.from(first).map((c) => <span class="hero__mask"><span class="hero__char" data-hero-char>{c}</span></span>)}
      </span>
    </div>

    <div class="hero__role" data-hero-hud>
      <p class="hero__role-line">
        {tr(profile.role, lang)} — <span class="serif">{focusA}</span>{focusRest.length ? ` & ${focusRest.join(' & ')}` : ''}
      </p>
      <p class="meta hero__stack"><span class="hero__tick" aria-hidden="true">[ </span><span data-scramble>{profile.stackLine}</span><span class="hero__tick" aria-hidden="true"> ]</span></p>
    </div>

    <a class="hero__scroll meta" href="#about" data-hero-hud aria-label={`${tr(ui.scroll, lang)} — ${tr(ui.nav.about, lang)}`}>
      <span class="hero__scroll-line" aria-hidden="true"><i></i></span>
      <span>{tr(ui.scroll, lang)}</span>
    </a>

    <div class="hero__info" data-hero-hud>
      <p class="hero__avail"><span class="hero__pulse" aria-hidden="true"></span>{tr(ui.available, lang)}</p>
      <p class="meta hero__loc">
        <span>{tr(profile.location, lang)}</span>
        <span class="hero__coords" data-scramble>{coords}</span>
      </p>
    </div>

    <div class="hero__word hero__word--b" data-hero-word="b" aria-hidden="true">
      <span class="hero__tilt" data-hero-tilt="1.6">
        {Array.from(last).map((c) => <span class="hero__mask"><span class="hero__char" data-hero-char>{c}</span></span>)}
      </span>
    </div>
  </div>

  <div class="hero__frame" aria-hidden="true" data-hero-hud>
    <span class="hero__corner hero__corner--tl"></span><span class="hero__corner hero__corner--tr"></span>
    <span class="hero__corner hero__corner--bl"></span><span class="hero__corner hero__corner--br"></span>
  </div>
</section>

<style>
  .hero { position: relative; min-height: 100vh; min-height: 100svh; overflow: hidden; overflow: clip; perspective: 1200px; }
  .hero__grid {
    position: relative; z-index: 1;
    min-height: 100vh; min-height: 100svh;
    display: grid;
    grid-template-columns: 1fr;
    grid-template-rows: auto auto 1fr auto auto;
    row-gap: 18px;
    padding-top: calc(84px + 2vh);
    padding-bottom: clamp(20px, 4vh, 44px);
  }

  /* ---------- giant name ---------- */
  .hero__word {
    font-weight: 700; letter-spacing: -0.055em; line-height: 0.8;
    font-size: min(25vw, 8rem);
    white-space: nowrap; will-change: transform;
    margin-inline: -0.04em;
  }
  .hero__word--a { grid-row: 1; justify-self: start; transform-origin: 0% 50%; }
  .hero__word--b { grid-row: 5; justify-self: end; transform-origin: 100% 50%; }
  .hero__tilt { display: inline-block; will-change: transform; }
  .hero__mask { display: inline-block; overflow: hidden; padding: 0.06em 0.02em 0.04em; margin: -0.06em -0.02em -0.04em; vertical-align: top; }
  .hero__char { display: inline-block; }
  /* outlined word: variable-font glyphs have overlapping contours, so paint the stroke first and
     cover its inner half with an ink fill (paint-order) — only the clean outer contour stays visible */
  .hero__word--b .hero__char {
    color: var(--ink-0);
    -webkit-text-stroke: max(2px, 0.022em) var(--fg);
    paint-order: stroke fill;
  }
  .hero__word--a .hero__char { color: var(--fg); }

  /* ---------- HUD ---------- */
  .hero__role { grid-row: 2; max-width: 22em; display: grid; gap: 10px; }
  .hero__role-line { font-size: var(--fs-lead); line-height: 1.2; letter-spacing: -0.02em; color: var(--fg); text-shadow: 0 0 24px rgba(5, 5, 7, 0.9); }
  .hero__role-line .serif { color: var(--signal); font-size: 1.12em; }
  .hero__stack { color: var(--fg-2); white-space: nowrap; font-size: min(var(--fs-meta), 3.1vw); }
  .hero__tick { color: var(--fg-3); }

  .hero__info { grid-row: 4; display: grid; gap: 10px; justify-self: start; }
  .hero__avail { display: inline-flex; align-items: center; gap: 10px; font-size: 0.95rem; color: var(--fg); text-shadow: 0 0 20px rgba(5, 5, 7, 0.9); }
  .hero__pulse { position: relative; width: 8px; height: 8px; border-radius: 50%; background: var(--signal); flex: none; }
  .hero__pulse::after {
    content: ''; position: absolute; inset: 0; border-radius: 50%; border: 1px solid var(--signal);
    animation: heroping 2s var(--ease-out) infinite;
  }
  @keyframes heroping { from { transform: scale(1); opacity: 0.9; } to { transform: scale(3.4); opacity: 0; } }
  .hero__loc { display: flex; flex-wrap: wrap; gap: 4px 14px; color: var(--fg-3); }
  .hero__coords { color: var(--fg-2); font-variant-numeric: tabular-nums; }

  .hero__scroll { display: none; }

  .hero__frame { position: absolute; inset: calc(76px + 1vh) var(--gutter) 14px; pointer-events: none; z-index: 0; }
  .hero__corner { position: absolute; width: 14px; height: 14px; border-color: var(--line-strong); border-style: solid; border-width: 0; }
  .hero__corner--tl { left: 0; top: 0; border-left-width: 1px; border-top-width: 1px; }
  .hero__corner--tr { right: 0; top: 0; border-right-width: 1px; border-top-width: 1px; }
  .hero__corner--bl { left: 0; bottom: 0; border-left-width: 1px; border-bottom-width: 1px; }
  .hero__corner--br { right: 0; bottom: 0; border-right-width: 1px; border-bottom-width: 1px; }

  @media (min-width: 768px) {
    .hero__grid { grid-template-columns: 1fr auto; row-gap: 0; padding-top: calc(96px + 4vh); }
    .hero__word { font-size: var(--fs-mega); }
    .hero__word--a { grid-column: 1 / -1; grid-row: 1; }
    .hero__word--b { grid-column: 1 / -1; grid-row: 5; }
    .hero__role { grid-column: 2; grid-row: 2; justify-self: end; text-align: right; margin-top: clamp(16px, 3vh, 40px); max-width: 19em; }
    .hero__info { grid-column: 1 / -1; grid-row: 5; align-self: end; padding-bottom: 0.6em; z-index: 1; }
    .hero__scroll {
      display: inline-flex; flex-direction: column; align-items: center; gap: 12px;
      grid-column: 1; grid-row: 3; align-self: center; justify-self: start; color: var(--fg-3);
      writing-mode: vertical-rl;
    }
    .hero__scroll:hover { color: var(--signal); }
  }
  @media (min-width: 1100px) {
    .hero__info { padding-bottom: 1.2em; }
  }
  .hero__scroll-line { position: relative; width: 1px; height: 64px; background: var(--line-strong); overflow: hidden; }
  .hero__scroll-line i { position: absolute; left: 0; top: 0; width: 100%; height: 40%; background: var(--signal); animation: heroscroll 2.2s var(--ease-in-out) infinite; }
  @keyframes heroscroll { from { transform: translateY(-100%); } to { transform: translateY(260%); } }

  @media (prefers-reduced-motion: reduce) {
    .hero__pulse::after, .hero__scroll-line i { animation: none; }
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  const hero = document.querySelector<HTMLElement>('.hero[data-gl="hero"]');
  if (hero) {
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const fine = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
    const charsA = hero.querySelectorAll<HTMLElement>('[data-hero-word="a"] [data-hero-char]');
    const charsB = hero.querySelectorAll<HTMLElement>('[data-hero-word="b"] [data-hero-char]');
    const hud = hero.querySelectorAll<HTMLElement>('[data-hero-hud]');
    // intro animates the HUD children, scroll animates the HUD containers (no property fights)
    const hudKids = hero.querySelectorAll<HTMLElement>('[data-hero-hud] > *');
    const wordA = hero.querySelector<HTMLElement>('[data-hero-word="a"]')!;
    const wordB = hero.querySelector<HTMLElement>('[data-hero-word="b"]')!;
    const tilts = Array.from(hero.querySelectorAll<HTMLElement>('[data-hero-tilt]'));

    if (!reduced) {
      gsap.set([...charsA, ...charsB], { yPercent: 120, rotate: 6, transformOrigin: '0% 100%' });
      gsap.set(hudKids, { autoAlpha: 0, y: 18 });
    }

    const intro = () => {
      if (reduced) return;
      gsap.timeline({ delay: 0.15 })
        .to(charsA, { yPercent: 0, rotate: 0, duration: 1.6, ease: 'expo.out', stagger: 0.07 })
        .to(charsB, { yPercent: 0, rotate: 0, duration: 1.6, ease: 'expo.out', stagger: 0.07 }, 0.22)
        .to(hudKids, { autoAlpha: 1, y: 0, duration: 1.2, ease: 'expo.out', stagger: 0.08 }, 0.7)
        .add(() => window.dispatchEvent(new CustomEvent('gl:pulse', { detail: { strength: 0.6 } })), 0.5);
    };
    if (document.documentElement.classList.contains('is-ready')) intro();
    else window.addEventListener('app:ready', intro, { once: true });

    if (!reduced) {
      // scroll: the name parts like a curtain and the camera falls into the core
      const mm = gsap.matchMedia();
      mm.add({ desk: '(min-width: 768px)', mob: '(max-width: 767.98px)' }, (ctx) => {
        const desk = ctx.conditions?.desk;
        gsap.timeline({
          scrollTrigger: { trigger: hero, start: 'top top', end: 'bottom top', scrub: 0.8, invalidateOnRefresh: true },
        })
          .to(wordA, { xPercent: desk ? -38 : -28, yPercent: desk ? 70 : 40, scale: desk ? 1.7 : 1.35, ease: 'none' }, 0)
          .to(wordB, { xPercent: desk ? 38 : 28, yPercent: desk ? -40 : -20, scale: desk ? 1.7 : 1.35, ease: 'none' }, 0)
          .to([wordA, wordB], { autoAlpha: 0.0, ease: 'power1.in', duration: 0.5 }, 0.5)
          .to(hud, { autoAlpha: 0, y: -40, ease: 'none', duration: 0.35, stagger: 0.03 }, 0);
      });

      // mouse: subtle 3D parallax of the type layers
      if (fine) {
        const qs = tilts.map((el) => ({
          d: parseFloat(el.dataset.heroTilt || '1'),
          x: gsap.quickTo(el, 'x', { duration: 1.2, ease: 'power3.out' }),
          y: gsap.quickTo(el, 'y', { duration: 1.2, ease: 'power3.out' }),
          ry: gsap.quickTo(el, 'rotationY', { duration: 1.2, ease: 'power3.out' }),
          rx: gsap.quickTo(el, 'rotationX', { duration: 1.2, ease: 'power3.out' }),
        }));
        tilts.forEach((el) => gsap.set(el, { transformPerspective: 900 }));
        let inView = true;
        ScrollTrigger.create({ trigger: hero, start: 'top bottom', end: 'bottom top', onToggle: (s) => (inView = s.isActive) });
        window.addEventListener('pointermove', (e) => {
          if (!inView || e.pointerType !== 'mouse') return;
          const nx = e.clientX / window.innerWidth - 0.5;
          const ny = e.clientY / window.innerHeight - 0.5;
          qs.forEach((q) => { q.x(-nx * 26 * q.d); q.y(-ny * 16 * q.d); q.ry(nx * 8 * q.d); q.rx(-ny * 6 * q.d); });
        }, { passive: true });
      }
    }
  }
</script>
