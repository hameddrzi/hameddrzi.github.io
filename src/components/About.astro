---
// OWNER: Agent "shell". About: story on the left, GL portrait on the right (desktop).
import { profile, stats, ui, tr, type Lang } from '../data/cv';
interface Props { lang: Lang }
const { lang } = Astro.props;
const summary = tr(profile.summary, lang);
const words = summary.split(/\s+/);
const h = lang === 'it'
  ? { a: 'Costruisco', b: 'interfacce', c: 'che le persone usano volentieri.' }
  : { a: 'I build', b: 'interfaces', c: 'people actually enjoy.' };
const kicker = lang === 'it' ? 'Dal design UI al codice in produzione' : 'From UI design to production code';
---
<section id="about" class="about" data-gl="about" data-gl-side="right" aria-labelledby="about-title">

  <div class="wrap about__grid">
    <div class="about__story">
      <p class="meta about__meta" data-reveal="fade"><span class="about__num">(01)</span> — {tr(ui.nav.about, lang)}</p>
      <h2 id="about-title" class="about__title" data-split="words">
        {h.a} <span class="serif">{h.b}</span> {h.c}
      </h2>
      <p class="meta about__kicker" data-reveal="fade" data-delay="0.2"><span aria-hidden="true">↳ </span>{kicker}</p>

      <p class="about__summary">
        <span class="sr-only">{summary}</span>
        <span aria-hidden="true" data-readalong>{words.map((w) => <span class="rw">{w} </span>)}</span>
      </p>

      <ol class="about__pillars">
        {profile.pillars.map((p, i) => (
          <li class="about__pillar" data-reveal="up">
            <span class="meta about__pillar-idx">{String(i + 1).padStart(2, '0')}</span>
            <span class="about__pillar-text">{tr(p, lang)}</span>
            <span class="about__pillar-dot" aria-hidden="true"></span>
          </li>
        ))}
      </ol>

      <div class="about__actions" data-reveal="up">
        <a class="btn btn--solid" href={profile.cvPdf[lang]} download data-magnetic data-cursor="PDF">
          <span>{tr(ui.downloadCv, lang)}</span><span class="btn__arrow" aria-hidden="true">↓</span>
        </a>
        <span class="meta about__lang">PDF · {lang.toUpperCase()}</span>
      </div>
    </div>

  </div>

  <div class="wrap">
    <ul class="about__stats">
      {stats.map((s) => (
        <li class="about__stat" data-reveal="up">
          <p class="about__stat-val"><span data-count={String(s.value)}>{s.value}</span><span class="about__stat-suf">{s.suffix}</span></p>
          <p class="about__stat-label">{tr(s.label, lang)}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .about { padding-block: var(--section-y); overflow-x: clip; }
    .about__grid { display: grid; grid-template-columns: 1fr; gap: 48px; position: relative; }
  .about__story { position: relative; display: grid; gap: clamp(22px, 3vw, 36px); align-content: start; max-width: 54rem; }
  .about__story::before {
    /* soft scrim over the particle portrait (mobile: it sits behind the text) */
    content: ''; position: absolute; inset: -10% calc(var(--gutter) * -1); z-index: -1; pointer-events: none;
    background: radial-gradient(closest-side, rgba(5, 5, 7, 0.72), rgba(5, 5, 7, 0.4) 60%, rgba(5, 5, 7, 0) 100%);
  }
  .about__num { color: var(--signal); }
  .about__title {
    font-size: var(--fs-h2); font-weight: 600; letter-spacing: -0.045em; line-height: 0.98;
    text-wrap: balance;
  }
  .about__title .serif { color: var(--signal); font-size: 1.08em; }
  .about__kicker { color: var(--fg-2); }

  .about__summary {
    font-size: var(--fs-lead); line-height: 1.42; letter-spacing: -0.012em; color: var(--fg);
    max-width: 34em;
  }
  .rw { transition: none; }

  .about__pillars { border-top: 1px solid var(--line); }
  .about__pillar {
    display: grid; grid-template-columns: 3.2em 1fr auto; align-items: center; gap: 12px;
    padding-block: clamp(14px, 1.8vw, 22px); border-bottom: 1px solid var(--line);
  }
  .about__pillar-idx { color: var(--fg-3); }
  .about__pillar-text { font-size: var(--fs-h3); letter-spacing: -0.03em; line-height: 1.1; font-weight: 500; }
  .about__pillar-dot { width: 7px; height: 7px; border-radius: 50%; border: 1px solid var(--line-strong); transition: background-color 0.4s, border-color 0.4s; }
  .about__pillar:hover .about__pillar-dot { background: var(--signal); border-color: var(--signal); }
  .about__pillar:hover .about__pillar-idx { color: var(--signal); }

  .about__actions { display: flex; align-items: center; gap: 18px; flex-wrap: wrap; padding-top: 8px; }
  .about__lang { color: var(--fg-3); }


  .about__stats {
    margin-top: clamp(64px, 10vw, 140px);
    display: grid; grid-template-columns: repeat(2, minmax(0, 1fr));
    border-top: 1px solid var(--line);
  }
  .about__stat { padding: 22px 0 8px; display: grid; gap: 10px; align-content: start; border-bottom: 1px solid var(--line); }
  .about__stat:nth-child(odd) { padding-right: 12px; border-right: 1px solid var(--line); }
  .about__stat:nth-child(even) { padding-left: 16px; }
  .about__stat-val {
    font-size: clamp(3.2rem, 8vw, 7.5rem); font-weight: 300; letter-spacing: -0.06em; line-height: 0.9;
    font-variant-numeric: tabular-nums;
  }
  .about__stat-suf { color: var(--signal); }
  .about__stat-label { font-size: 0.92rem; color: var(--fg-2); line-height: 1.35; max-width: 18em; padding-bottom: 14px; }

  @media (min-width: 768px) {
    .about__grid { grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr); gap: 4vw; }
    .about__story::before { background: radial-gradient(closest-side, rgba(5, 5, 7, 0.6), rgba(5, 5, 7, 0.3) 60%, rgba(5, 5, 7, 0) 100%); }
    .about__stats { grid-template-columns: repeat(4, minmax(0, 1fr)); }
    .about__stat { border-bottom: 0; padding: 28px 20px 0 20px !important; border-right: 1px solid var(--line); }
    .about__stat:first-child { padding-left: 0 !important; }
    .about__stat:last-child { border-right: 0; }
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  const words = document.querySelectorAll<HTMLElement>('#about [data-readalong] .rw');
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (words.length && !reduced) {
    const host = words[0].closest('.about__summary') as HTMLElement;
    gsap.fromTo(words, { opacity: 0.14 }, {
      opacity: 1, ease: 'none', stagger: 0.1,
      scrollTrigger: { trigger: host, start: 'top 82%', end: 'bottom 48%', scrub: 0.6 },
    });
  }
</script>
